# SkillTrack AI — FastAPI Backend Environment Variables Template

APP_NAME="SkillTrack AI Backend"
APP_ENV=development
DEBUG=True
PORT=8000

# Security & Secret Keys
SECRET_KEY=your-super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Supabase PostgreSQL / SQLite placeholder)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skilltrack_db

# Supabase Auth Integration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_placeholder

# CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://skilltrack.ai"]
